{
  "name": "sift",
  "version": "0.0.1",
  "description": "Chrome extension: ask questions about the page you're on, backed by Nebius Token Factory (NVIDIA Nemotron) with a Tavily site-scoped search fallback.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test:nebius": "node --env-file=.env scripts/test-nebius.mjs",
    "test:tools": "node --env-file=.env scripts/test-nebius-tools.mjs",
    "test:eval": "node --env-file=.env node_modules/.bin/vitest run --config vitest.eval.config.ts",
    "dev": "vite",
    "dev:content": "vite build --watch --config vite.content.config.ts",
    "build": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.23",
    "@mozilla/readability": "^0.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
